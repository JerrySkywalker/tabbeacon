* text=auto

# Cross-platform source, policy, and project metadata use LF.
*.rs text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf

# Native Windows command scripts keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
